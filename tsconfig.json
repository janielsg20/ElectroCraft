{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@electrocraft/domain": ["packages/domain/index.ts"],
      "@electrocraft/application": ["packages/application/index.ts"],
      "@electrocraft/design-system": ["packages/design-system/index.ts"]
    }
  },
  "include": ["apps/**/*", "packages/**/*", "experiments/**/*"]
}
